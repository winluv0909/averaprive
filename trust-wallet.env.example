# Add these entries to .env.local; keep existing PayPal and Supabase entries.
# Enable only after applying migration 025, configuring endpoints and starting the worker.
WALLET_CRYPTO_ENABLED=false

# Private HTTPS mainnet JSON-RPC URLs from your blockchain infrastructure provider.
# Never prefix these variables with NEXT_PUBLIC_. Never use a testnet endpoint.
WALLET_RPC_ERC20=
WALLET_RPC_BEP20=
WALLET_RPC_ARBITRUM=
WALLET_RPC_BASE=

# TronGrid mainnet REST URL (the /wallet and /v1 paths are appended by the server).
WALLET_RPC_TRC20=https://api.trongrid.io
TRONGRID_API_KEY=

# Two independent mainnet Esplora-compatible Bitcoin sources.
# Public endpoints are suitable for initial checks, not a high-volume production SLA.
WALLET_RPC_BITCOIN=https://blockstream.info/api
WALLET_BTC_SECONDARY_URL=https://mempool.space/api

# Tatum API key: used only for a fresh BTC/USD price quote, never to hold funds.
TATUM_API_KEY=

# At least 32 random characters; use the generation command in the guide.
CRYPTO_MONITOR_SECRET=

# Keep your existing public website URL. This is where the worker calls the app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Existing server-only Supabase credentials are still required (do not replace them).
# NEXT_PUBLIC_SUPABASE_URL=your-existing-value
# SUPABASE_SERVICE_ROLE_KEY=your-existing-private-value

# Required for invoice email delivery; keep existing values if already configured.
# RESEND_API_KEY=
# PAYMENT_EMAIL_FROM=Billing <billing@your-verified-domain>
# PAYMENT_ADMIN_EMAILS=your-admin-email
