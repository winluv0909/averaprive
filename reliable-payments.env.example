# Server-only Binance account verification; do not enable withdrawals/trading.
CRYPTO_CUSTODIAN=binance
BINANCE_READ_API_KEY=
BINANCE_READ_API_SECRET=
# Supplied public receiving addresses are defaults in receivers.ts.
# Shared checkout reuses these destinations. Ambiguous deposits require owner review.
# REFERENCE ONLY. Merge chosen settings into .env.local; do not overwrite existing settings.
# Server secrets must never use NEXT_PUBLIC_ prefixes. Never put private keys here.
CRYPTO_RPC_BEP20=
CRYPTO_RPC_ERC20=
CRYPTO_RPC_TRC20=
CRYPTO_RPC_SOL=
CRYPTO_GENESIS_SOL=
CRYPTO_GENESIS_TRC20=
TRONGRID_API_KEY=
TATUM_API_KEY=

# USDT_BEP20
CRYPTO_TOKEN_USDT_BEP20=
CRYPTO_DECIMALS_USDT_BEP20=
CRYPTO_WALLETS_USDT_BEP20='[]'

# USDT_TRC20
CRYPTO_TOKEN_USDT_TRC20=
CRYPTO_DECIMALS_USDT_TRC20=
CRYPTO_WALLETS_USDT_TRC20='[]'

# USDT_ERC20
CRYPTO_TOKEN_USDT_ERC20=
CRYPTO_DECIMALS_USDT_ERC20=
CRYPTO_WALLETS_USDT_ERC20='[]'

# USDT_SOL
CRYPTO_TOKEN_USDT_SOL=
CRYPTO_DECIMALS_USDT_SOL=
CRYPTO_WALLETS_USDT_SOL='[]'

# USDC_BEP20
CRYPTO_TOKEN_USDC_BEP20=
CRYPTO_DECIMALS_USDC_BEP20=
CRYPTO_WALLETS_USDC_BEP20='[]'

# USDC_ERC20
CRYPTO_TOKEN_USDC_ERC20=
CRYPTO_DECIMALS_USDC_ERC20=
CRYPTO_WALLETS_USDC_ERC20='[]'

# USDC_SOL
CRYPTO_TOKEN_USDC_SOL=
CRYPTO_DECIMALS_USDC_SOL=
CRYPTO_WALLETS_USDC_SOL='[]'

# BTC_BEP20 (wrapped/tokenized BTC, not native Bitcoin)
CRYPTO_TOKEN_BTC_BEP20=
CRYPTO_DECIMALS_BTC_BEP20=
CRYPTO_WALLETS_BTC_BEP20='[]'

# BTC_ERC20 (wrapped/tokenized BTC, not native Bitcoin)
CRYPTO_TOKEN_BTC_ERC20=
CRYPTO_DECIMALS_BTC_ERC20=
CRYPTO_WALLETS_BTC_ERC20='[]'

CRYPTO_MONITOR_SECRET=
RESEND_API_KEY=
PAYMENT_EMAIL_FROM=
PAYMENT_ADMIN_EMAILS=
# Keep your existing NEXT_PUBLIC_SITE_URL; use localhost for local testing.
